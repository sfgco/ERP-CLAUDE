# Per-worktree settings — copy to `.env` in THIS worktree's root (gitignored). docs/WORKTREES.md has the table.
# `npm run wt:new <department> <slice>` writes this file for you; `npm run wt:env <department>` rewrites it.
#
#   worktree      API_PORT  WEB_PORT  DEV_DB_NAME
#   erp-1 (main)  4000      5200      eayni_main
#   erp-1-sales   4100      5210      eayni_sales
#   erp-1-hr      4200      5220      eayni_hr
#   erp-1-finance 4300      5230      eayni_finance
#
API_PORT=4000
WEB_PORT=5200
# Database name on the shared local MongoDB (127.0.0.1:27117, data under the main checkout's apps/api/.data/mongo).
DEV_DB_NAME=eayni_main
# Set MONGODB_URI only to use another server (Atlas, docker); it replaces DEV_DB_NAME and the auto-started local server.
# MONGODB_URI=
